# ──────────────────────────────────────────────────────────────────────────
# DAMP Frontend — variables de entorno
# Copiar a `.env` para desarrollo local. En Dockploy, cargar estos mismos
# nombres como variables de entorno de la app. Ver damp/DEPLOY.md.
#
# IMPORTANTE: las que empiezan con NEXT_PUBLIC_ se "hornean" en el bundle del
# cliente durante `next build` (build-time), no se leen en runtime — si se
# despliega con Docker, van como build args (ver frontend/Dockerfile), no solo
# como variables de entorno del contenedor corriendo.
# ──────────────────────────────────────────────────────────────────────────

# ── Clerk (autenticación) ───────────────────────────────────────────────────
# Mismo par publishable/secret que usa el backend — Dashboard de Clerk > API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ── Backend API ──────────────────────────────────────────────────────────────
# Server-side only (no lleva NEXT_PUBLIC_): el frontend actúa de proxy/BFF hacia
# el backend (ver src/lib/proxy.ts), el browser nunca le pega directo a esta URL.
# Local:      http://localhost:3001
# Dockploy (misma red interna que docker-compose.prod.yml): http://backend:3001
API_BASE_URL=
