# Running Port
PORT=3001

# Frontend URL
FRONTEND_URL=

# Database Connection
# Use this URL for local development with Docker Compose:
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/damp_db?schema=public"
# For production/staging cloud database (e.g. Neon):
# DATABASE_URL="postgresql://neondb_owner:password@host/neondb?sslmode=require"

# Clerk Environment Variables (Auth / Webhooks)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=

# ML Service (predicción de eventos de salud con el modelo LSTM real, ver damp/ml-service y damp-ml-api)
ML_SERVICE_URL=http://localhost:8000