# ──────────────────────────────────────────────────────────────────────────
# DAMP Backend — variables de entorno
# Copiar a `.env` para desarrollo local. En Dockploy, cargar estos mismos
# nombres como variables de entorno de la app (no se usa archivo .env ahí).
# Ver damp/DEPLOY.md para el detalle de qué valor va en cada una en producción.
# ──────────────────────────────────────────────────────────────────────────

# Puerto en el que escucha el backend (NestJS)
PORT=3001

# URL del frontend, para habilitar CORS (debe coincidir exacto, sin barra final)
# Local:      http://localhost:3000
# Producción: https://<dominio-del-frontend-en-dockploy>
FRONTEND_URL=

# ── Base de datos (PostgreSQL + extensión PostGIS) ─────────────────────────
# Local con Docker Compose (ver ../docker-compose.yml, servicio "db"):
DATABASE_URL="postgresql://postgres:postgres@localhost:5435/damp_db?schema=public"
# Producción (Postgres de Dockploy, o Neon/Supabase/RDS): la extensión PostGIS
# tiene que estar habilitada en esa base ANTES de levantar el backend
# (`CREATE EXTENSION IF NOT EXISTS postgis;`) — sin eso, las migraciones fallan.
# DATABASE_URL="postgresql://user:password@host:5432/damp_db?schema=public"

# ── Autenticación JWT ─────────────────────────────────────────────────────────
# Clave secreta para firmar tokens JWT (generar una segura en producción)
JWT_SECRET=damp-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ── ML Service (predicción de eventos de salud, ver damp/ml-service y damp-ml-api) ──
# Local con Docker Compose: http://localhost:8000
# Dentro de docker-compose.prod.yml (misma red interna): http://ml-service:8000
ML_SERVICE_URL=http://localhost:8000
