generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  farmUsers FarmUser[]

  @@map("roles")
}

model User {
  id         String     @id @default(uuid())
  clerkId    String     @unique @map("clerk_id")
  email      String     @unique
  globalRole GlobalRole @default(USER) @map("global_role")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  farmUsers FarmUser[]

  @@map("users")
}

model Farm {
  id          String   @id @default(uuid())
  name        String?
  address     String?
  province    String?
  location    String?
  totalAreaHa Float?   @map("total_area_ha")
  userId      String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  farmUsers FarmUser[]
  sectors   Sector[]
  animals   Animal[]
  zones     Zone[]

  @@map("farms")
}

model FarmUser {
  id     String @id @default(uuid())
  farmId String @map("farm_id")
  userId String @map("user_id")
  roleId String @map("role_id")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([farmId, userId])
  @@map("farm_users")
}

model Sector {
  id          String   @id @default(uuid())
  farmId      String   @map("farm_id")
  name        String?
  description String?
  areaHa      Float?   @map("area_ha")
  geometry    Unsupported("geometry(Polygon, 4326)")?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  farm      Farm       @relation(fields: [farmId], references: [id])
  geofences Geofence[]

  @@map("sectors")
}

model Geofence {
  id          String   @id @default(uuid())
  sectorId    String   @map("sector_id")
  name        String?
  geometry    Unsupported("geometry(Polygon, 4326)")?
  active      Boolean?
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sector          Sector           @relation(fields: [sectorId], references: [id])
  animalGeofences AnimalGeofence[]

  @@map("geofences")
}

model Animal {
  id           String      @id @default(uuid())
  farmId       String      @map("farm_id")
  tag          String?
  sex          Sex?
  birthDate    DateTime?   @map("birth_date")
  breed        String?
  weightKg     Float?      @map("weight_kg")
  animalTypeId String?     @map("animal_type_id")
  zoneId       String?     @map("zone_id")

  isArchived   Boolean     @default(false) @map("is_archived")
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now()) @map("created_at")

  farm            Farm              @relation(fields: [farmId], references: [id])
  animalType      AnimalType?       @relation(fields: [animalTypeId], references: [id])
  zone            Zone?             @relation(fields: [zoneId], references: [id])
  medicalEvents   MedicalEvent[]
  animalGeofences AnimalGeofence[]
  animalCollars   AnimalCollar[]
  alerts          Alert[]

  @@map("animals")
}

model Collar {
  id                Int                  @id @default(autoincrement())
  lastTelemetryDate DateTime?            @map("last_telemetry_date")

  animalCollars     AnimalCollar[]
  telemetryReadings TelemetryReading[]

  @@map("collars")
}

model AnimalCollar {
  id       String   @id @default(uuid())
  collarId Int      @map("collar_id")
  animalId String   @map("animal_id")
  startAt  DateTime @map("start_at")
  endAt    DateTime? @map("end_at")

  collar Collar @relation(fields: [collarId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])

  @@map("animal_collars")
}

model MedicalEvent {
  id          String @id @default(uuid())
  animalId    String            @map("animal_id")
  type        MedicalEventType?
  description String?
  occurredAt  DateTime          @map("occurred_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id])

  @@map("medical_events")
}

model AnimalGeofence {
  id         String    @id @default(uuid()) 
  animalId   String    @map("animal_id")
  geofenceId String    @map("geofence_id")
  startAt    DateTime  @map("start_at")
  endAt      DateTime? @map("end_at")

  animal   Animal   @relation(fields: [animalId], references: [id])
  geofence Geofence @relation(fields: [geofenceId], references: [id])

  @@map("animal_geofences")
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Sex {
  MALE
  FEMALE
}

enum MedicalEventType {
  VACCINATION
  TREATMENT
  SURGERY
}

model Zone {
  id                 String   @id @default(uuid())
  name               String
  pastureType        String?  @map("pasture_type")
  farmId             String   @map("farm_id")
  polygonCoordinates Json?    @map("polygon_coordinates")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  farm    Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals Animal[]

  @@map("zones")
}

model AnimalType {
  id          String   @id @default(uuid())
  name        String   @unique
  species     String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  animals Animal[]

  @@map("animal_types")
}

model TelemetryReading {
  id          String   @id @default(uuid())
  collarId    Int      @map("collar_id")
  latitude    Float
  longitude   Float
  temperature Float
  timestamp   DateTime @default(now())

  collar Collar @relation(fields: [collarId], references: [id], onDelete: Cascade)

  @@map("telemetry_readings")
}

enum AlertType {
  ESCAPE
  HEALTH
  SYSTEM
}

model Alert {
  id         String    @id @default(uuid())
  type       AlertType
  message    String
  animalId   String    @map("animal_id")
  isResolved Boolean   @default(false) @map("is_resolved")
  createdAt  DateTime  @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("alerts")
}
