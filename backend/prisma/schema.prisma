generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GlobalRole {
  SUPER_ADMIN
  USER
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  farmUsers FarmUser[]

  @@map("roles")
}

model User {
  id         String     @id @default(uuid())
  clerkId    String     @unique @map("clerk_id")
  email      String     @unique
  globalRole GlobalRole @default(USER) @map("global_role")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  farmUsers FarmUser[]

  @@map("users")
}

model Farm {
  id          String   @id @default(uuid())
  name        String?
  address     String?
  province    String?
  location    String?
  totalAreaHa        Float?   @map("total_area_ha")
  polygonCoordinates Json?    @map("polygon_coordinates")
  userId             String?  @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  farmUsers     FarmUser[]
  animals       Animal[]
  zones         Zone[]
  gateways      Gateway[]
  alertSettings AlertSettings?

  @@map("farms")
}

model FarmUser {
  id         String    @id @default(uuid())
  farmId     String    @map("farm_id")
  userId     String    @map("user_id")
  roleId     String    @map("role_id")
  isActive   Boolean   @default(true) @map("is_active")
  removedAt  DateTime? @map("removed_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([farmId, userId])
  @@map("farm_users")
}

model Geofence {
  id                 String    @id @default(uuid())
  zoneId             String    @map("zone_id")
  name               String
  polygonCoordinates Json?     @map("polygon_coordinates")
  active             Boolean   @default(true)
  activatedAt        DateTime? @map("activated_at")
  deactivatedAt      DateTime? @map("deactivated_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  zone            Zone             @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  animalGeofences AnimalGeofence[]

  @@map("geofences")
}

model Animal {
  id           String      @id @default(uuid())
  farmId       String      @map("farm_id")
  tag          String?
  sex          Sex?
  birthDate    DateTime?   @map("birth_date")
  breed        String?
  weightKg     Float?      @map("weight_kg")
  animalTypeId String?     @map("animal_type_id")
  zoneId       String?     @map("zone_id")

  isArchived   Boolean     @default(false) @map("is_archived")
  status       String      @default("ACTIVE")
  createdAt    DateTime    @default(now()) @map("created_at")

  farm            Farm              @relation(fields: [farmId], references: [id])
  animalType      AnimalType?       @relation(fields: [animalTypeId], references: [id])
  zone            Zone?             @relation(fields: [zoneId], references: [id])
  medicalEvents   MedicalEvent[]
  animalGeofences AnimalGeofence[]
  animalCollars   AnimalCollar[]
  alerts          Alert[]

  @@map("animals")
}

enum CollarStatus {
  AVAILABLE
  DAMAGED
  OUT_OF_SERVICE
}

model Collar {
  id                Int          @id @default(autoincrement())
  identifier        String       @unique
  status            CollarStatus @default(AVAILABLE)
  lastTelemetryDate DateTime?    @map("last_telemetry_date")
  createdAt         DateTime     @default(now()) @map("created_at")

  animalCollars     AnimalCollar[]
  telemetryReadings TelemetryReading[]

  @@map("collars")
}

model AnimalCollar {
  id       String   @id @default(uuid())
  collarId Int      @map("collar_id")
  animalId String   @map("animal_id")
  startAt  DateTime @map("start_at")
  endAt    DateTime? @map("end_at")

  collar Collar @relation(fields: [collarId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])

  @@map("animal_collars")
}

model MedicalEvent {
  id          String            @id @default(uuid())
  animalId    String            @map("animal_id")
  type        MedicalEventType?
  description String?
  value       Float?
  occurredAt  DateTime          @map("occurred_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id])

  @@map("medical_events")
}

model AnimalGeofence {
  id         String    @id @default(uuid()) 
  animalId   String    @map("animal_id")
  geofenceId String    @map("geofence_id")
  startAt    DateTime  @map("start_at")
  endAt      DateTime? @map("end_at")

  animal   Animal   @relation(fields: [animalId], references: [id])
  geofence Geofence @relation(fields: [geofenceId], references: [id])

  @@map("animal_geofences")
}

enum Sex {
  MALE
  FEMALE
}

enum MedicalEventType {
  VACCINATION
  TREATMENT
  SURGERY
  WEIGHING
  BIRTH
}

model Zone {
  id                 String   @id @default(uuid())
  name               String
  pastureType        String?  @map("pasture_type")
  farmId             String   @map("farm_id")
  polygonCoordinates Json?    @map("polygon_coordinates")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  farm      Farm       @relation(fields: [farmId], references: [id], onDelete: Cascade)
  animals   Animal[]
  geofences Geofence[]
  gateways  Gateway[]

  @@map("zones")
}

model Gateway {
  id         String    @id @default(uuid())
  name       String
  farmId     String    @map("farm_id")
  zoneId     String    @map("zone_id")
  apiKey     String    @unique @map("api_key")
  lastSeenAt DateTime? @map("last_seen_at")
  lastRssi   Float?    @map("last_rssi")
  lastSnr    Float?    @map("last_snr")
  createdAt  DateTime  @default(now()) @map("created_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  zone Zone @relation(fields: [zoneId], references: [id], onDelete: Cascade)

  @@map("gateways")
}

model AnimalType {
  id          String   @id @default(uuid())
  name        String   @unique
  species     String
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  animals Animal[]

  @@map("animal_types")
}

model TelemetryReading {
  id          String   @id @default(uuid())
  collarId    Int      @map("collar_id")
  latitude    Float
  longitude   Float
  temperature Float
  timestamp   DateTime @default(now())

  collar Collar @relation(fields: [collarId], references: [id], onDelete: Cascade)

  @@map("telemetry_readings")
}

enum AlertType {
  ESCAPE
  HEALTH
  SYSTEM
}

model Alert {
  id         String    @id @default(uuid())
  type       AlertType
  message    String
  animalId   String    @map("animal_id")
  isResolved Boolean   @default(false) @map("is_resolved")
  createdAt  DateTime  @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@map("alerts")
}

model AlertSettings {
  id                   String   @id @default(uuid())
  farmId               String   @unique @map("farm_id")
  feverThreshold       Float    @default(39.5) @map("fever_threshold")
  hypothermiaThreshold Float    @default(37.0) @map("hypothermia_threshold")
  inactivityMinutes    Int      @default(120) @map("inactivity_minutes")
  emailOnEscape        Boolean  @default(false) @map("email_on_escape")
  emailOnHealth        Boolean  @default(false) @map("email_on_health")
  updatedAt            DateTime @updatedAt @map("updated_at")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@map("alert_settings")
}
