generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  createdAt   DateTime @default(now()) @map("created_at")

  farmUsers FarmUser[]

  @@map("role")
}

model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique @map("clerk_id")
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  farmUsers FarmUser[]

  @@map("users")
}

model Farm {
  id          String   @id @default(uuid())
  name        String?
  address     String?
  province    String?
  totalAreaHa Float?   @map("total_area_ha")
  createdAt   DateTime @default(now()) @map("created_at")

  farmUsers FarmUser[]
  sectors   Sector[]
  animals   Animal[]

  @@map("farm")
}

model FarmUser {
  id     String @id @default(uuid())
  farmId String @map("farm_id")
  userId String @map("user_id")
  roleId String @map("role_id")

  farm Farm @relation(fields: [farmId], references: [id])
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])

  @@unique([farmId, userId])
  @@map("farm_user")
}

model Sector {
  id          String   @id @default(uuid())
  farmId      String   @map("farm_id")
  name        String?
  description String?
  areaHa      Float?   @map("area_ha")
  geometry    Unsupported("geometry(Polygon, 4326)")?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  
  farm      Farm       @relation(fields: [farmId], references: [id])
  geofences Geofence[]

  @@map("sector")
}

model Geofence {
  id          String   @id @default(uuid())
  sectorId    String   @map("sector_id")
  name        String?
  geometry    Unsupported("geometry(Polygon, 4326)")?
  active      Boolean?
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sector          Sector           @relation(fields: [sectorId], references: [id])
  animalGeofences AnimalGeofence[]

  @@map("geofence")
}

model Animal {
  id         String      @id @default(uuid())
  farmId     String      @map("farm_id")
  tag        String?
  sex        Sex?
  birthDate  DateTime?   @map("birth_date")
  breed      String?
  weightKg   Float?      @map("weight_kg")
  animalType AnimalType? @map("animal_type")
  status     String      @default("ACTIVE")
  createdAt  DateTime    @default(now()) @map("created_at")

  farm            Farm              @relation(fields: [farmId], references: [id])
  medicalEvents   MedicalEvent[]
  telemetry       TelemetryRecord[]
  animalGeofences AnimalGeofence[]
  animalCollars   AnimalCollar[]

  @@map("animal")
}

model Collar {
  id              String        @id @default(uuid())
  serialNumber    String?       @unique @map("serial_number")
  status          String?
  firmwareVersion String?       @map("firmware_version")

  telemetry     TelemetryRecord[]
  animalCollars AnimalCollar[]

  @@map("collar")
}

model AnimalCollar {
  id       String    @id @default(uuid())
  collarId String    @map("collar_id")
  animalId String    @map("animal_id")
  startAt  DateTime  @map("start_at")
  endAt    DateTime? @map("end_at")

  collar Collar @relation(fields: [collarId], references: [id])
  animal Animal @relation(fields: [animalId], references: [id])

  @@map("animal_collar")
}

model MedicalEvent {
  id          String @id @default(uuid())
  animalId    String            @map("animal_id")
  type        MedicalEventType?
  description String?
  occurredAt  DateTime          @map("occurred_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  animal Animal @relation(fields: [animalId], references: [id])

  @@map("medical_event")
}

model TelemetryRecord {
  id          String   @id @default(uuid())
  animalId    String   @map("animal_id")
  collarId    String   @map("collar_id")
  temperature Float?
  heartRate   Float?   @map("heart_rate")
  location    Unsupported("geometry(Polygon, 4326)")?
  recordedAt  DateTime @map("recorded_at")

  animal Animal @relation(fields: [animalId], references: [id])
  collar Collar @relation(fields: [collarId], references: [id])

  @@map("telemetry_record")
}

model AnimalGeofence {
  id         String    @id @default(uuid()) 
  animalId   String    @map("animal_id")
  geofenceId String    @map("geofence_id")
  startAt    DateTime  @map("start_at")
  endAt      DateTime? @map("end_at")

  animal   Animal   @relation(fields: [animalId], references: [id])
  geofence Geofence @relation(fields: [geofenceId], references: [id])

  @@map("animal_geofence")
}

model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

enum Sex {
  MALE
  FEMALE
}

enum AnimalType {
  COW
}

enum MedicalEventType {
  VACCINATION
  TREATMENT
  SURGERY
}
