# ──────────────────────────────────────────────────────────────────────────
# DAMP — Variables de entorno para producción (Dockploy + docker-compose.prod.yml)
#
# Esto NO es un .env que se use directo (docker-compose.prod.yml no tiene una
# directiva env_file apuntando acá) — es la lista consolidada, en formato pegable,
# de todo lo que hay que cargar como "Environment Variables" del proyecto en la
# UI de Dockploy. Ver DEPLOY.md para el paso a paso completo de dónde sale cada valor.
#
# docker-compose.prod.yml ya se encarga de:
#   - fijar ML_SERVICE_URL=http://ml-service:8000 (red interna del compose)
#   - fijar API_BASE_URL=http://backend:3001 (ídem)
#   - pasar NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY también como build arg del frontend
# No hace falta cargar esas dos URLs acá.
# ──────────────────────────────────────────────────────────────────────────

# Base de datos — Postgres nativo de Dockploy (con PostGIS habilitado, ver DEPLOY.md paso 2)
# o un Postgres externo (Neon/Supabase/RDS) que ya tenga la extensión postgis.
DATABASE_URL=

# Dominio público del frontend, para CORS del backend (sin barra final)
FRONTEND_URL=

# Clerk — Dashboard de Clerk > API Keys y > Webhooks
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
